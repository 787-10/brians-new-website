{% extends "layout" %}
{% block page %}

<style>
 img {
    width: 100%;
 }

 p, p * , blockquote, blockquote * , li, li * {
    font-family: Georgia, serif;
 }

 h1 {
    margin-bottom: 1rem;
 }

 h2 {
    padding-top: 1.5rem;
 }

 blockquote {
    border-left: 3px solid #8e8e8e;
    padding: 0.25em 0 0.25em 1.25em;
    margin: 1.5em 0;
    color: #5a5a5a;
 }
</style>

</br>
<a onclick="history.back()" style="cursor: pointer;">< back</a>
</br>
</br>

<h5 style="margin-bottom:0px; float: right;">by <em>Brian Wu</em></h5>
{{raw_post | safe }}

{% endblock %}
