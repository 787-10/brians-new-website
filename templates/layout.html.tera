<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-9QSLC9W16Q"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-9QSLC9W16Q');
    </script>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!--<link rel="stylesheet" href="/static/index.css">-->

    <style>
      @font-face {
          font-family: SFMono;
          src: url("/static/fonts/SFMonoRegular.otf") format("opentype");
      }

      @font-face{
          font-family: SFMono;
          font-weight: bold;
          src: url("/static/fonts/SFMonoBold.otf") format("opentype");
      }

      @font-face{
          font-family: SFMono;
          font-style: italic;
          src: url("/static/fonts/SFMonoRegularItalic.otf") format("opentype");
      }

      *{
          font-family: SFMono, monospace;
          letter-spacing: 0px;
      }

      .list{
          margin-bottom: 0px;
      }

      .at-row {
        display: flex;
        align-items: baseline;
      }
      .at-row .role-name {
        flex: 0 0 auto;
      }
      .at-row .at-value {
        flex: 1 1 auto;
        min-width: 0;
      }

      @media (max-width: 575.98px) {
        .at-row {
          display: block;
          margin-bottom: 0.5rem;
        }
        .at-row .role-name,
        .at-row .at-value {
          display: block;
          width: auto !important;
        }
        .at-row .at-value {
          padding-left: 1rem;
        }
      }

      .dark-mode {
        background-color: black;
        color: white;
      }
      .dark-mode a{
        color: #d9deff;
      }
      .light-mode {
        background-color: white;
        color: black;
      }

      /* Quotes page */
      .quote-block {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 1.2em 1.5em;
        margin-bottom: 1.2em;
      }
      .dark-mode .quote-block {
        border-color: #444;
      }
      .quote-block blockquote {
        border-left: 3px solid #8e8e8e;
        padding-left: 1em;
        margin: 0;
      }
      .quote-block .attribution {
        margin-top: 0.5em;
        margin-bottom: 0;
        padding-left: 1em;
        color: #8e8e8e;
        font-size: 0.9em;
      }
      .quote-block .commentary {
        margin-top: 0.6em;
        margin-bottom: 0;
        padding-left: 1em;
        font-style: italic;
        color: #6a6a6a;
        font-size: 0.9em;
        border-top: 1px solid #eee;
        padding-top: 0.6em;
      }
      .dark-mode .quote-block .commentary {
        border-top-color: #444;
        color: #999;
      }

    </style>

    <title>Brian Y. Wu</title>
  </head>
  <body>
    <div class="container">

      {% block page %}
      {% endblock %}

    </div><!--- main div --->
    <script>
      var dark = true;

      function toggle(){
          if(dark){
              lightMode();
          } else darkMode();
      }

      function darkMode() {
        dark = true;
        var element = document.body;
        element.className = "dark-mode";
      }
      function lightMode() {
        dark = false;
        var element = document.body;
        element.className = "light-mode";
      }
    </script>
  </body>
</html>
